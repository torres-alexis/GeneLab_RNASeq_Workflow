/*
    Fetch jobs use --pbs_internet_queue when set.
*/

includeConfig 'process_resources.config'

params {
    pbs_queue = 'normal'
    pbs_model = ''
    pbs_internet_queue = ''
}

process {
    executor = 'pbspro'
    resourceLimits = [ time: 8.h ]
    cache = 'lenient'
    queue = {
        def s = (params.pbs_queue instanceof CharSequence) ? params.pbs_queue.toString().trim() : ""
        if ( s in ['true', 'false'] ) s = ""
        s ?: 'normal'
    }
    clusterOptions = {
        def raw = params.pbs_model
        def s = (raw instanceof CharSequence) ? raw.toString().trim() : ""
        if ( s in ['true', 'false'] ) s = ""
        def model = s ? ":model=${s}" : ""
        def mem_gb = task.memory.toGiga()
        if ( mem_gb < 1 ) mem_gb = 1
        "-l select=1:ncpus=${task.cpus}:mem=${mem_gb}GB${model}"
    }
    withName: 'GET_ACCESSIONS|FETCH_ISA|GET_OSDR_FILE_LIST|FETCH_READS|FETCH_BAM|FETCH_GENES_RESULTS|FETCH_TABLE|FETCH_COUNTS_TABLE|FETCH_DGE_TABLE|FETCH_ANNOTATIONS_TABLE|FETCH_GENE_ANNOTATIONS|DOWNLOAD_REFERENCES|DOWNLOAD_ERCC' {
        queue = {
            def iq = (params.pbs_internet_queue instanceof CharSequence) ? params.pbs_internet_queue.toString().trim() : ""
            if ( iq in ['true', 'false'] ) iq = ""
            def q = (params.pbs_queue instanceof CharSequence) ? params.pbs_queue.toString().trim() : ""
            if ( q in ['true', 'false'] ) q = ""
            iq ?: q ?: 'normal'
        }
    }
    withName: 'DOWNLOAD_REFERENCES|COPY_REFERENCES|DOWNLOAD_ERCC|SUBSAMPLE_GENOME|CONCAT_ERCC|GTF_TO_PRED|PRED_TO_BED|BUILD_STAR_INDEX|BUILD_RSEM_INDEX|BUILD_BOWTIE2_INDEX' {
        afterScript = 'sleep 60'
    }
}

executor {
    queueSize = 32
    pollInterval = '2 min'
    queueStatInterval = '5 min'
    submitRateLimit = '10/1min'
    exitReadTimeout = '15 min'
}
