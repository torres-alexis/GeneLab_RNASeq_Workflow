/*
    Shared process cpus/memory/time. Executor knobs (queueSize, maxForks,
    clusterOptions) live in slurm.config / pbspro.config / local.config.

    Retries: OOM only (130..145 + 104).
    memory = { base + step * (task.attempt - 1) }
    Omit step ⇒ step = base (same as base * attempt).
    Do not scale cpus with attempt.
*/

process {
    cpus   = 1
    memory = { 1.GB + 1.GB * (task.attempt - 1) }
    time   = {
        def s = (params.walltime instanceof CharSequence) ? params.walltime.toString().trim() : ""
        if( !s || s in ['true', 'false'] ) return 2.hour
        return params.walltime
    }

    withName: 'INFER_EXPERIMENT|FETCH_REMOTE_READS|FETCH_REMOTE_BAM|ALL_MULTIQC|TRIMMED_READS_MULTIQC|ALIGN_BOWTIE2|BUILD_STAR_INDEX' { time = 4.hour }
    withName:TRIMGALORE { time = 8.hour }
    withName:RAW_FASTQC { time = 10.hour }
    withName: 'TRIMMED_FASTQC|INNER_DISTANCE' { time = 12.hour }
    withName:READ_DISTRIBUTION { time = 16.hour }
    withName:SORT_AND_INDEX_BAM { time = 24.hour }
    withName:COUNT_ALIGNED { time = 72.hour }
    withName: 'VV_TRIMMED_READS|VV_RAW_READS' { time = 96.hour }
    withName:GENEBODY_COVERAGE { time = 120.hour }
    withName:ALIGN_STAR { time = 170.hour }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withName:UPDATE_ASSAY_TABLE {
        cpus   = 1
        memory = { 4.GB + 4.GB * (task.attempt - 1) }
        errorStrategy = 'ignore'
    }
    withName:'GET_ACCESSIONS|FETCH_ISA|ISA_TO_RUNSHEET|PARSE_ANNOTATIONS_TABLE|COPY_READS|COPY_REFERENCES|FETCH_REMOTE_READS|FETCH_REMOTE_BAM|FETCH_REMOTE_GENES_RESULTS|DOWNLOAD_REFERENCES|DOWNLOAD_ERCC|CONCAT_ERCC|GTF_TO_PRED|PRED_TO_BED|GET_MAX_READ_LENGTH|INFER_EXPERIMENT|ASSESS_STRANDEDNESS|QUANTIFY_STAR_GENES|EXTRACT_RRNA|REMOVE_RRNA|QUANTIFY_RSEM_GENES|RAW_READS_MULTIQC|TRIMMED_READS_MULTIQC|ALIGN_MULTIQC|INFER_EXPERIMENT_MULTIQC|GENEBODY_COVERAGE_MULTIQC|INNER_DISTANCE_MULTIQC|READ_DISTRIBUTION_MULTIQC|COUNT_MULTIQC|ALL_MULTIQC|PARSE_QC_METRICS|VV_RAW_READS|VV_TRIMMED_READS|VV_STAR_ALIGNMENT|VV_RSEQC|VV_RSEM_COUNTS|VV_CONCAT_FILTER|SOFTWARE_VERSIONS|GENERATE_PROTOCOL|SPLIT_ORGANISM_PART_RUNSHEETS|FILTER_UNALIGNABLE' {
        cpus   = 1
        memory = { 1.GB + 1.GB * (task.attempt - 1) }
    }
    withName:VV_DGE_DESEQ2 {
        cpus   = 1
        memory = { 4.GB + 2.GB * (task.attempt - 1) }
    }
    withName:ERCC_ANALYSIS {
        cpus   = 2
        memory = { 4.GB + 4.GB * (task.attempt - 1) }
    }
    withName:READ_DISTRIBUTION {
        cpus   = 1
        memory = { 2.GB + 2.GB * (task.attempt - 1) }
    }
    withName:GENERATE_MD5SUMS {
        cpus   = 1
        memory = { 8.GB + 8.GB * (task.attempt - 1) }
    }
    withName:GENEBODY_COVERAGE {
        cpus   = 2
        memory = { 2.GB + 2.GB * (task.attempt - 1) }
    }
    withName:'RAW_FASTQC|TRIMMED_FASTQC' {
        cpus   = 2
        memory = { 4.GB + 2.GB * (task.attempt - 1) }
    }
    withName:INNER_DISTANCE {
        cpus   = 2
        memory = { 4.GB + 2.GB * (task.attempt - 1) }
    }
    withName:ANNOTATE_DGE_TABLE {
        cpus   = 2
        memory = { 4.GB + 4.GB * (task.attempt - 1) }
    }
    withName:SORT_AND_INDEX_BAM {
        cpus   = 4
        memory = { 16.GB + 8.GB * (task.attempt - 1) }
    }
    withName:'DGE_DESEQ2|DGE_DESEQ2_RRNA_RM' {
        cpus   = 4
        memory = { 8.GB + 8.GB * (task.attempt - 1) }
    }
    withName:TRIMGALORE {
        cpus   = 8
        memory = 2.GB
    }
    withName:COUNT_ALIGNED {
        cpus   = 8
        memory = { 8.GB + 8.GB * (task.attempt - 1) }
        maxRetries = 2
    }
    withName:ALIGN_STAR {
        cpus   = 8
        memory = { 48.GB + 16.GB * (task.attempt - 1) }
        maxRetries = 4
    }
    withName:BUILD_STAR_INDEX {
        cpus   = 16
        memory = { 60.GB + 16.GB * (task.attempt - 1) }
    }
    withName:BUILD_RSEM_INDEX {
        cpus   = 2
        memory = { 8.GB + 8.GB * (task.attempt - 1) }
    }
    withName:'VV_BOWTIE2_ALIGNMENT|VV_FEATURECOUNTS|QUANTIFY_FEATURECOUNTS_GENES|REMOVE_RRNA_FEATURECOUNTS' {
        cpus   = 1
        memory = 1.GB
    }
    withName:GET_GTF_FEATURES {
        cpus   = 1
        memory = 2.GB
    }
    withName:BUILD_BOWTIE2_INDEX {
        cpus   = 4
        memory = { 2.GB + 2.GB * (task.attempt - 1) }
    }
    withName:ALIGN_BOWTIE2 {
        cpus   = 4
        memory = { 4.GB + 4.GB * (task.attempt - 1) }
    }
    withName:FEATURECOUNTS {
        cpus   = 8
        memory = { 4.GB + 4.GB * (task.attempt - 1) }
    }
}
